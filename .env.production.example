# Server Configuration
NODE_ENV=production
PORT=3000

# Database Connection (Production PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://username:production_password@your-db-host:5432/sigana_prod

# JWT Auth Configuration (Use strong random strings)
JWT_SECRET=your_production_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_production_refresh_secret_key_here

# Security & CORS (Set to frontend domain)
CORS_ORIGIN=https://sigana.id

# Logging 
LOG_LEVEL=info

# App Configuration
APP_URL=https://api.sigana.id

# Email Service (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@sigana.id
PASSWORD_RESET_EXPIRES_IN=1h

# Provider Email
EMAIL_PROVIDER=resend
