// --- SISTEM SIGANA DATABASE SCHEMA ---

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// 1. Manajemen Pengguna & Akses
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  phone        String?
  nik          String?
  role         Role          @default(RELAWAN)
  status       UserStatus    @default(PENDING)
  isVerified   Boolean       @default(false) // Verifikasi oleh Admin
  lastLoginAt  DateTime?
  villageId    Int?
  village      Village?      @relation(fields: [villageId], references: [id], onDelete: SetNull)
  measurements Measurement[]
  sessions     UserSession[]
  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?     // Soft Delete
  refreshToken String?       // Hashed Refresh Token for Single Session Strategy
  pushSubscriptions Json?
  passwordResets PasswordReset[]
  reports        Report[]

  @@map("users")
}

enum Role {
  RELAWAN
  ADMIN
  STAKEHOLDER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

// 2. Normalisasi Wilayah & Geo-Location
model Village {
  id        Int      @id @default(autoincrement())
  name      String // Nama Desa
  districts String // Nama Kecamatan
  latitude  Float? // Koordinat untuk Peta Sebaran (dipindah dari Posko)
  longitude Float?
  isActive  Boolean  @default(true)
  users     User[]
  balitas   Balita[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("villages")
}

model KbmReference {
  id         Int      @id @default(autoincrement())
  usiaBulan  Int      @unique
  kbmMinimal Int
  updatedAt  DateTime @updatedAt
  updatedBy  String?

  @@map("kbm_references")
}

model SystemConfig {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_configs")
}

model WhoDataset {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  description String
  version     String
  lastUpdated DateTime
  ageRange    String
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("who_datasets")
}

// 3. Data Master Balita (Induk)
model Balita {
  id           String        @id @default(uuid())
  namaAnak     String
  namaOrtu     String
  tanggalLahir DateTime // Untuk hitung Umur Bulan otomatis
  jenisKelamin Gender
  villageId    Int
  village      Village       @relation(fields: [villageId], references: [id], onDelete: Cascade)
  measurements Measurement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("balitas")
}

enum Gender {
  L
  P
}

// 4. Data Transaksi Pengukuran (Antropometri)
model Measurement {
  id            String   @id @default(uuid())
  balitaId      String
  balita        Balita   @relation(fields: [balitaId], references: [id], onDelete: Cascade)
  relawanId     String
  relawan       User     @relation(fields: [relawanId], references: [id], onDelete: Cascade)

  // Input Fisik
  beratBadan    Float
  tinggiBadan   Float
  lingkarKepala Float
  lila          Float
  posisiUkur    Posisi // TERLENTANG / BERDIRI

  // Tambahan Questionnaire
  notes              String?  @db.Text
  sanitationData     Json?
  medicalHistoryData Json?

  // V2 Questionnaire Data
  imunisasiData      Json?
  klinikData         Json?
  giziData           Json?

  // Output Z-Score (Permenkes 2/2020)
  bb_u_status   String
  tb_u_status   String
  bb_tb_status  String
  lk_u_status   String? // Lingkar Kepala / Umur
  lila_u_status String? // Lingkar Lengan Atas / Umur
  imt_u_status  String? // Indeks Massa Tubuh / Umur
  statusAkhir   Status // HIJAU (Aman), KUNING (Waspada), MERAH (Bahaya)

  // PRD v1.4 — Onboarding, Komparasi & Etik
  isDisasterArea   Boolean  @default(false) // 1.1 Screening Gate: Wilayah Terdampak Bencana
  tinggiBadanOrtu  Float?                   // 1.2 Hal.1: Tinggi Badan Orang Tua (cm) — Komparasi
  informedConsent  Boolean  @default(false) // 1.4 Modul Etik: Informed Consent orang tua/wali

  // Mekanisme Sync PWA
  isSynced      Boolean  @default(true)
  localId       String? // ID dari IndexedDB untuk rekonsiliasi data
  deletedAt     DateTime? // Tombstone untuk Downstream Sync

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([balitaId])
  @@index([relawanId])
  @@index([statusAkhir])
  @@index([createdAt])
  @@index([deletedAt])

  @@map("measurements")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique  // Hashed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId   String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  event      String
  module     String
  action     String
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetId   String?
  target     User?    @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)
  ipAddress  String?
  device     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum Posisi {
  TERLENTANG
  BERDIRI
}

// 5. Laporan Gizi
model Report {
  id            String       @id @default(uuid())
  title         String
  format        ReportFormat
  status        ReportStatus @default(PROCESSING)
  config        Json         // Stores GenerateReportDTO
  filePath      String?      // Path to generated file on disk
  generatedAt   DateTime?
  generatedById String
  generatedBy   User         @relation(fields: [generatedById], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("reports")
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

enum ReportStatus {
  PROCESSING
  DONE
  FAILED
}

enum Status {
  HIJAU
  KUNING
  MERAH
}
